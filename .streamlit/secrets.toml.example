# Streamlit Cloud 배포용 Secrets 예시
# ─────────────────────────────────────────────
# 사용법:
#   • 로컬: 이 파일을 .streamlit/secrets.toml 로 복사 후 값 입력
#   • Streamlit Cloud: 앱 설정 → Settings → Secrets 에 아래 내용 붙여넣기
#
# ※ secrets.toml 은 절대 git에 커밋하지 마세요 (.gitignore 확인)

# 필수 — 한국은행 ECOS 인증키 (https://ecos.bok.or.kr/api/ 무료 발급)
ECOS_API_KEY = "여기에_ECOS_인증키"

# 선택 — 자연어 파싱 LLM (없으면 규칙 기반 파서로 동작)
# GEMINI_API_KEY = "여기에_Gemini_키"
# OPENAI_API_KEY = "여기에_OpenAI_키"

# 선택 — 공사비(건설공사비지수) 기능용 (준비 중, KOSIS 공유서비스 발급)
# KOSIS_API_KEY = "여기에_KOSIS_인증키"
