# 세션 서명 키 — 반드시 직접 설정하세요 (없으면 재시작 때마다 로그인이 풀립니다)
#   python -c "import secrets;print(secrets.token_hex(32))"
TJ_SECRET=여기에_임의의_긴_문자열

# DB 선택 — 비워두면 SQLite 파일, 채우면 PostgreSQL 을 씁니다.
#   Supabase: 대시보드 > Project Settings > Database > Connection string (URI, 6543 포트 풀러 권장)
#   Neon / Render: 대시보드가 주는 External Database URL 을 그대로 붙여넣기
# DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# SQLite 파일 위치 (DATABASE_URL 이 없을 때만 사용, 기본: server/data/journal.db)
TJ_DB=./server/data/journal.db

# 회원가입 정책: auto(첫 계정만 허용, 기본) | 1(항상 허용) | 0(항상 차단)
TJ_ALLOW_REGISTER=auto

# 로그인 유지 기간(일), 이미지 1장 최대 용량(MB)
TJ_SESSION_DAYS=30
TJ_MAX_IMAGE_MB=8

# PostgreSQL 커넥션 풀 크기 (DATABASE_URL 을 쓸 때만)
TJ_PG_MIN=1
TJ_PG_MAX=10
